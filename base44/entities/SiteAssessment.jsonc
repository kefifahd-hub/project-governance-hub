{
  "name": "SiteAssessment",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string"
    },
    "assessmentName": {
      "type": "string"
    },
    "assessmentDate": {
      "type": "string",
      "format": "date"
    },
    "assessmentStatus": {
      "type": "string",
      "enum": [
        "Draft",
        "Under Review",
        "Finalist Selected",
        "Complete"
      ],
      "default": "Draft"
    },
    "assessmentOwner": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "categoryWeights": {
      "type": "string",
      "description": "JSON: {ownership, plot, utilities, infrastructure, workforce, incentives}"
    }
  },
  "required": [
    "projectId",
    "assessmentName"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}