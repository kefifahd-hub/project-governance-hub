{
  "name": "GrantAssumptions",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent FinanceModel/Project (denormalized for RLS)"
    },
    "financeModelId": {
      "type": "string"
    },
    "grantName": {
      "type": "string",
      "description": "e.g., Subsidy 1, IPCEI Grant"
    },
    "cashReceiptMEur": {
      "type": "number",
      "description": "Total grant amount \u20acM"
    },
    "receiptQuarter": {
      "type": "string",
      "description": "When cash is received, e.g., Q1 2027"
    },
    "amortizationStartQuarter": {
      "type": "string",
      "description": "When P&L recognition starts, e.g., Q4 2028"
    },
    "amortizationYears": {
      "type": "number",
      "default": 10
    }
  },
  "required": [
    "financeModelId",
    "grantName"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}