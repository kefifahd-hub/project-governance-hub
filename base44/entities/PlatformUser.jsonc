{
  "name": "PlatformUser",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Active/primary Organization (drives RLS scope)"
    },
    "org_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All Organizations this user is a member of (multi-domain). org_id is the active one."
    },
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "role_id": {
      "type": "string",
      "description": "Reference to PlatformRole"
    },
    "role_name": {
      "type": "string",
      "description": "Cached role name"
    },
    "org_name": {
      "type": "string",
      "description": "Cached org name"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "invited_by": {
      "type": "string"
    },
    "invited_at": {
      "type": "string"
    },
    "last_login": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "access_end_date": {
      "type": "string",
      "format": "date"
    },
    "platform_role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Platform-level access role (admin = can manage users, user = app access only)"
    }
  },
  "required": [
    "email",
    "full_name",
    "org_id",
    "role_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}