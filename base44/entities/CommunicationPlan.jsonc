{
  "name": "CommunicationPlan",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "audience": {
      "type": "string",
      "description": "Target audience"
    },
    "information": {
      "type": "string",
      "description": "Information to communicate"
    },
    "purpose": {
      "type": "string",
      "description": "Purpose"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "Daily",
        "Weekly",
        "Bi-weekly",
        "Monthly",
        "Quarterly",
        "Milestone",
        "Ad-hoc"
      ],
      "default": "Weekly"
    },
    "channel": {
      "type": "string",
      "enum": [
        "Email",
        "Meeting",
        "Report",
        "Dashboard",
        "Call",
        "Workshop"
      ],
      "default": "Email"
    },
    "format": {
      "type": "string",
      "description": "Format"
    },
    "owner": {
      "type": "string",
      "description": "Owner"
    },
    "notes": {
      "type": "string",
      "description": "Notes"
    }
  },
  "required": [
    "projectId",
    "audience"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}