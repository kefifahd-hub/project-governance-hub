{
  "name": "LogisticsAssumptions",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent FinanceModel/Project (denormalized for RLS)"
    },
    "financeModelId": {
      "type": "string"
    },
    "cellNumber": {
      "type": "string",
      "enum": [
        "Cell 1",
        "Cell 2",
        "Cell 3"
      ]
    },
    "inboundLogisticsPct": {
      "type": "number",
      "description": "% of purchased parts cost. Default: 4.5"
    },
    "inboundDutyPct": {
      "type": "number",
      "description": "% of purchased parts cost. Default: 2.5"
    }
  },
  "required": [
    "financeModelId",
    "cellNumber"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}