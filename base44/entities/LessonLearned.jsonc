{
  "name": "LessonLearned",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "title": {
      "type": "string",
      "description": "Lesson title"
    },
    "category": {
      "type": "string",
      "enum": [
        "Technical",
        "Commercial",
        "Schedule",
        "Safety",
        "Quality",
        "Procurement",
        "Stakeholder",
        "HSE"
      ],
      "description": "Lesson category"
    },
    "phase": {
      "type": "string",
      "description": "Project phase the lesson arose in"
    },
    "whatHappened": {
      "type": "string",
      "description": "What happened"
    },
    "rootCause": {
      "type": "string",
      "description": "Root cause"
    },
    "impact": {
      "type": "string",
      "description": "Impact"
    },
    "recommendation": {
      "type": "string",
      "description": "Recommendation"
    },
    "lessonType": {
      "type": "string",
      "enum": [
        "Success",
        "Improvement"
      ],
      "default": "Improvement"
    },
    "owner": {
      "type": "string",
      "description": "Owner"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Actioned",
        "Closed"
      ],
      "default": "Open"
    },
    "dateIdentified": {
      "type": "string",
      "format": "date"
    },
    "linkedRiskId": {
      "type": "string",
      "description": "Linked Risk record ID (optional)"
    },
    "linkedActionId": {
      "type": "string",
      "description": "Linked ActionItem record ID (optional)"
    }
  },
  "required": [
    "projectId",
    "title"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}