{
  "name": "Stakeholder",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "stakeholderName": {
      "type": "string",
      "description": "Stakeholder name"
    },
    "role": {
      "type": "string",
      "description": "Role / title"
    },
    "company": {
      "type": "string",
      "description": "Company / organization"
    },
    "category": {
      "type": "string",
      "enum": [
        "Internal",
        "External"
      ],
      "default": "Internal"
    },
    "influence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "default": "Medium"
    },
    "interest": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "default": "Medium"
    },
    "engagementCurrent": {
      "type": "string",
      "enum": [
        "Unaware",
        "Resistant",
        "Neutral",
        "Supportive",
        "Leading"
      ],
      "default": "Neutral"
    },
    "engagementDesired": {
      "type": "string",
      "enum": [
        "Unaware",
        "Resistant",
        "Neutral",
        "Supportive",
        "Leading"
      ],
      "default": "Supportive"
    },
    "engagementStrategy": {
      "type": "string",
      "description": "Engagement strategy"
    },
    "contact": {
      "type": "string",
      "description": "Contact info"
    },
    "notes": {
      "type": "string",
      "description": "Notes"
    }
  },
  "required": [
    "projectId",
    "stakeholderName"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}