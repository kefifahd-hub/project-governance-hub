{
  "name": "OverheadAssumptions",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent FinanceModel/Project (denormalized for RLS)"
    },
    "financeModelId": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Operational",
        "G&A",
        "Launch"
      ]
    },
    "lineItem": {
      "type": "string",
      "description": "e.g., Rent, Property Tax, Insurance"
    },
    "costBasis": {
      "type": "string",
      "enum": [
        "Per Quarter (fixed)",
        "Per GWh (variable)",
        "% Revenue"
      ]
    },
    "amount": {
      "type": "number",
      "description": "Cost per unit of basis (EUR if fixed, EUR/GWh if variable, % if revenue)"
    }
  },
  "required": [
    "financeModelId",
    "category",
    "lineItem"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}