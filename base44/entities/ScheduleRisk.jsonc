{
  "name": "ScheduleRisk",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "project": {
      "type": "string",
      "description": "Project ID"
    },
    "name": {
      "type": "string",
      "description": "Risk name"
    },
    "description": {
      "type": "string",
      "description": "Risk description"
    },
    "linkedTaskId": {
      "type": "string",
      "description": "Linked ScheduleActivity ID"
    },
    "durationVariationMin": {
      "type": "number",
      "default": -10,
      "description": "Minimum duration variation % (can be negative)"
    },
    "durationVariationMax": {
      "type": "number",
      "default": 30,
      "description": "Maximum duration variation %"
    },
    "costVariationMin": {
      "type": "number",
      "default": -5,
      "description": "Minimum cost variation %"
    },
    "costVariationMax": {
      "type": "number",
      "default": 20,
      "description": "Maximum cost variation %"
    },
    "probability": {
      "type": "number",
      "default": 80,
      "minimum": 0,
      "maximum": 100,
      "description": "Probability this risk occurs (0-100)"
    }
  },
  "required": [
    "project",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}