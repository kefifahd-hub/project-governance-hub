{
  "name": "WeeklyReportSectionConfig",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string"
    },
    "sectionId": {
      "type": "string"
    },
    "sectionLabel": {
      "type": "string"
    },
    "sectionIcon": {
      "type": "string"
    },
    "dataSource": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sortOrder": {
      "type": "number",
      "default": 0
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "isCustom": {
      "type": "boolean",
      "default": false
    },
    "customContentTemplate": {
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "sectionId",
    "sectionLabel"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}