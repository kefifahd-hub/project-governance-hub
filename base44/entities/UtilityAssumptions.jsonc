{
  "name": "UtilityAssumptions",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent FinanceModel/Project (denormalized for RLS)"
    },
    "financeModelId": {
      "type": "string"
    },
    "electricityGwhPerGwh": {
      "type": "number",
      "default": 18,
      "description": "MWh electricity per MWh battery"
    },
    "electricityCostEurMwh": {
      "type": "number",
      "default": 111.2
    },
    "gasGwhPerGwh": {
      "type": "number",
      "default": 15
    },
    "gasCostEurMwh": {
      "type": "number",
      "default": 55
    },
    "waterM3PerGwh": {
      "type": "number",
      "default": 200
    },
    "waterCostEurM3": {
      "type": "number",
      "default": 1.15
    },
    "waterFixedFeeEurMonth": {
      "type": "number",
      "default": 500
    },
    "wastewaterM3PerGwh": {
      "type": "number",
      "default": 170
    },
    "wastewaterCostEurM3": {
      "type": "number",
      "default": 1.35
    }
  },
  "required": [
    "financeModelId"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}