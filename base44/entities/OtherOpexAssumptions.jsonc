{
  "name": "OtherOpexAssumptions",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent FinanceModel/Project (denormalized for RLS)"
    },
    "financeModelId": {
      "type": "string"
    },
    "outboundLogisticsPctRevenue": {
      "type": "number",
      "default": 1,
      "description": "Default: 1%"
    },
    "royaltyPctRevenue": {
      "type": "number",
      "default": 3,
      "description": "Default: 3%"
    },
    "warrantyPctRevenue": {
      "type": "number",
      "default": 2,
      "description": "Default: 2%"
    },
    "rdPctRevenue": {
      "type": "number",
      "default": 0,
      "description": "Default: 0% (handled in separate R&D model)"
    }
  },
  "required": [
    "financeModelId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}