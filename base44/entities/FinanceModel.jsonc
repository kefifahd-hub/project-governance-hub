{
  "name": "FinanceModel",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "modelName": {
      "type": "string",
      "description": "e.g., Verkor Base Case R11"
    },
    "version": {
      "type": "string",
      "description": "e.g., v11"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Under Review",
        "Approved",
        "Superseded"
      ],
      "default": "Draft"
    },
    "currency": {
      "type": "string",
      "enum": [
        "EUR",
        "USD",
        "GBP"
      ],
      "default": "EUR"
    },
    "startQuarter": {
      "type": "string",
      "description": "e.g., Q4 2025"
    },
    "endYear": {
      "type": "number",
      "description": "e.g., 2040"
    },
    "notes": {
      "type": "string",
      "description": "Version changelog / description"
    }
  },
  "required": [
    "projectId",
    "modelName"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}