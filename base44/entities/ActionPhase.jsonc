{
  "name": "ActionPhase",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string"
    },
    "phaseName": {
      "type": "string"
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "endDate": {
      "type": "string",
      "format": "date"
    },
    "phaseType": {
      "type": "string",
      "enum": [
        "Sprint",
        "Monthly",
        "Gate Phase",
        "Custom"
      ],
      "default": "Gate Phase"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planning",
        "Active",
        "Complete"
      ],
      "default": "Planning"
    },
    "goal": {
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "phaseName",
    "startDate",
    "endDate"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}