{
  "name": "Audit",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "auditRef": {
      "type": "string",
      "description": "Audit reference e.g. AUD-2026-001"
    },
    "auditType": {
      "type": "string",
      "enum": [
        "Internal",
        "External",
        "Regulatory",
        "ISO",
        "Client",
        "Supplier"
      ],
      "default": "Internal"
    },
    "auditScope": {
      "type": "string",
      "description": "Scope of the audit"
    },
    "auditor": {
      "type": "string",
      "description": "Auditor name / firm"
    },
    "auditDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planned",
        "In Progress",
        "Reporting",
        "Closed"
      ],
      "default": "Planned"
    }
  },
  "required": [
    "projectId",
    "auditRef"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}