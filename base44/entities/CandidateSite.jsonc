{
  "name": "CandidateSite",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent SiteAssessment/Project (denormalized for RLS). Note: this entity references assessmentId (SiteAssessment), not projectId directly."
    },
    "assessmentId": {
      "type": "string"
    },
    "siteName": {
      "type": "string"
    },
    "siteAddress": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active Candidate",
        "Shortlisted",
        "Finalist",
        "Selected",
        "Rejected"
      ],
      "default": "Active Candidate"
    }
  },
  "required": [
    "assessmentId",
    "siteName"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}