{
  "name": "DailyPrinciple",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date this principle banner applies to"
    },
    "title": {
      "type": "string",
      "description": "Principle banner title"
    },
    "subtitle": {
      "type": "string",
      "description": "Short explanatory subtitle"
    },
    "principles": {
      "type": "string",
      "description": "JSON array of {label, color} pillars"
    },
    "source": {
      "type": "string",
      "default": "PMO Agent"
    }
  },
  "required": [
    "date",
    "title",
    "principles"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.org_id": "{{user.data.org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.org_id": "{{user.data.org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.org_id": "{{user.data.org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}