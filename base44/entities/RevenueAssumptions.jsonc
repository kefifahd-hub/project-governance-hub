{
  "name": "RevenueAssumptions",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent FinanceModel/Project (denormalized for RLS)"
    },
    "financeModelId": {
      "type": "string"
    },
    "cellNumber": {
      "type": "string",
      "enum": [
        "Cell 1",
        "Cell 2",
        "Cell 3"
      ]
    },
    "quarter": {
      "type": "string",
      "description": "e.g., Q4 2028"
    },
    "sellingPriceEurKwh": {
      "type": "number",
      "description": "EUR/kWh selling price"
    },
    "priceChangePct": {
      "type": "number",
      "description": "Period-over-period price change %"
    },
    "rampPct": {
      "type": "number",
      "description": "Production ramp % (0-100)"
    },
    "yieldPct": {
      "type": "number",
      "description": "Yield for this specific quarter %"
    }
  },
  "required": [
    "financeModelId",
    "cellNumber",
    "quarter"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}