{
  "name": "SCurveComment",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "project": {
      "type": "string",
      "description": "Project ID"
    },
    "period": {
      "type": "string",
      "description": "Period label this comment refers to (e.g. Jan 25)"
    },
    "comment": {
      "type": "string",
      "description": "Comment text"
    },
    "author": {
      "type": "string",
      "description": "Author name or email"
    },
    "createdAt": {
      "type": "string",
      "format": "date",
      "description": "Date comment was created"
    }
  },
  "required": [
    "project",
    "comment",
    "author"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}