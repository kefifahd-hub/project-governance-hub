{
  "name": "BudgetTracking",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "month": {
      "type": "string",
      "format": "date",
      "description": "Month/Year"
    },
    "category": {
      "type": "string",
      "enum": [
        "Engineering",
        "Equipment",
        "Construction",
        "Procurement",
        "PMO",
        "Contingency",
        "Other"
      ],
      "description": "Budget category"
    },
    "wbsCode": {
      "type": "string",
      "description": "Optional WBS code reference"
    },
    "plannedEurK": {
      "type": "number",
      "description": "Planned amount in EUR thousands"
    },
    "actualEurK": {
      "type": "number",
      "description": "Actual amount in EUR thousands"
    },
    "varianceEurK": {
      "type": "number",
      "description": "Variance in EUR thousands (calculated)"
    },
    "variancePercent": {
      "type": "number",
      "description": "Variance percentage (calculated)"
    },
    "varianceStatus": {
      "type": "string",
      "enum": [
        "Over Budget",
        "On Track",
        "Under Budget"
      ],
      "description": "Variance status (calculated)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "projectId",
    "month",
    "category",
    "plannedEurK"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}