{
  "name": "QualityGate",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "gateNumber": {
      "type": "number",
      "description": "Gate number 0-7"
    },
    "gateName": {
      "type": "string",
      "description": "Gate name"
    },
    "status": {
      "type": "string",
      "enum": [
        "Not Reached",
        "Active",
        "Passed",
        "Passed with Reserves",
        "Not Passed"
      ],
      "default": "Not Reached"
    },
    "decisionDate": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string",
      "description": "Gate owner / decision maker"
    },
    "decisionAuthority": {
      "type": "string",
      "description": "Decision authority"
    },
    "decisionNotes": {
      "type": "string",
      "description": "Decision notes"
    },
    "checklist": {
      "type": "string",
      "description": "JSON array of {id, text, checked}"
    },
    "reserves": {
      "type": "string",
      "description": "Conditions that must be resolved"
    },
    "reservesDueDate": {
      "type": "string",
      "format": "date"
    },
    "reservesResolved": {
      "type": "boolean",
      "default": false
    },
    "evidenceNotes": {
      "type": "string"
    },
    "nextGateCriteria": {
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "gateNumber",
    "gateName"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}