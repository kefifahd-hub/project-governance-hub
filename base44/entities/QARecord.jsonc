{
  "name": "QARecord",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "recordType": {
      "type": "string",
      "enum": [
        "FAT",
        "SAT",
        "Inspection",
        "Audit",
        "Commissioning Test",
        "Other"
      ],
      "description": "Type of QA/QC activity"
    },
    "testName": {
      "type": "string",
      "description": "Name of test or inspection"
    },
    "equipmentSystem": {
      "type": "string",
      "description": "Equipment or system being tested"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "In Progress",
        "Passed",
        "Failed",
        "Conditional Pass",
        "Cancelled"
      ],
      "default": "Scheduled",
      "description": "Current status"
    },
    "scheduledDate": {
      "type": "string",
      "format": "date",
      "description": "Scheduled date"
    },
    "completedDate": {
      "type": "string",
      "format": "date",
      "description": "Actual completion date"
    },
    "location": {
      "type": "string",
      "description": "Test location"
    },
    "inspector": {
      "type": "string",
      "description": "Inspector/responsible person"
    },
    "vendor": {
      "type": "string",
      "description": "Vendor/contractor"
    },
    "ncCount": {
      "type": "integer",
      "default": 0,
      "description": "Number of non-conformities raised"
    },
    "findings": {
      "type": "string",
      "description": "Test findings and observations"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "projectId",
    "recordType",
    "testName"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}