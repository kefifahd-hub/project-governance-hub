{
  "name": "ActionComment",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent ActionItem (denormalized for RLS)"
    },
    "actionItemId": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "commentText": {
      "type": "string"
    },
    "commentType": {
      "type": "string",
      "enum": [
        "Comment",
        "Status Change",
        "Field Change",
        "Attachment",
        "Link Added"
      ],
      "default": "Comment"
    },
    "attachmentUrl": {
      "type": "string"
    }
  },
  "required": [
    "actionItemId",
    "author",
    "commentText"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}