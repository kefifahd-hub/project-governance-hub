{
  "name": "RaciAssignment",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "activity": {
      "type": "string",
      "description": "Activity or deliverable"
    },
    "wbsCode": {
      "type": "string",
      "description": "Optional WBS code reference"
    },
    "roleName": {
      "type": "string",
      "description": "Role or person name"
    },
    "responsibility": {
      "type": "string",
      "enum": [
        "R",
        "A",
        "C",
        "I"
      ],
      "default": "C"
    },
    "notes": {
      "type": "string",
      "description": "Notes"
    }
  },
  "required": [
    "projectId",
    "activity",
    "roleName",
    "responsibility"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}