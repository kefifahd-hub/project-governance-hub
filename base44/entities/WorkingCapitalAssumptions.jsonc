{
  "name": "WorkingCapitalAssumptions",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent FinanceModel/Project (denormalized for RLS)"
    },
    "financeModelId": {
      "type": "string"
    },
    "arPaymentTermsDays": {
      "type": "number",
      "default": 30,
      "description": "Accounts receivable days (max 90)"
    },
    "apPaymentTermsDays": {
      "type": "number",
      "default": 45,
      "description": "Accounts payable days (max 90)"
    },
    "inventoryDays": {
      "type": "number",
      "default": 69,
      "description": "Inventory days (42 transit + 7 WH + 20 WIP/FP)"
    }
  },
  "required": [
    "financeModelId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}