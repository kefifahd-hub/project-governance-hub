{
  "name": "ActionChecklist",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent ActionItem (denormalized for RLS)"
    },
    "actionItemId": {
      "type": "string"
    },
    "checklistText": {
      "type": "string"
    },
    "isChecked": {
      "type": "boolean",
      "default": false
    },
    "assignee": {
      "type": "string"
    },
    "dueDate": {
      "type": "string",
      "format": "date"
    },
    "sortOrder": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "actionItemId",
    "checklistText"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}