{
  "name": "WbsElement",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "wbsCode": {
      "type": "string",
      "description": "WBS code e.g. 1.2.3"
    },
    "name": {
      "type": "string",
      "description": "Element name"
    },
    "description": {
      "type": "string",
      "description": "Description"
    },
    "elementType": {
      "type": "string",
      "enum": [
        "Phase",
        "Deliverable",
        "Work Package"
      ],
      "default": "Work Package"
    },
    "owner": {
      "type": "string",
      "description": "Owner"
    },
    "status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Complete"
      ],
      "default": "Not Started"
    },
    "budgetEurK": {
      "type": "number",
      "description": "Budget in EUR thousands",
      "default": 0
    }
  },
  "required": [
    "projectId",
    "wbsCode",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}