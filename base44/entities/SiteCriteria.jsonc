{
  "name": "SiteCriteria",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent SiteAssessment/Project (denormalized for RLS). Note: this entity references siteId (CandidateSite), not projectId directly."
    },
    "siteId": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "criterionKey": {
      "type": "string"
    },
    "criterionLabel": {
      "type": "string"
    },
    "requirement": {
      "type": "string"
    },
    "response": {
      "type": "string"
    },
    "meetsRequirement": {
      "type": "string",
      "enum": [
        "Yes",
        "Partial",
        "No",
        "N/A",
        "TBD"
      ],
      "default": "TBD"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "remarks": {
      "type": "string"
    }
  },
  "required": [
    "siteId",
    "criterionKey",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}