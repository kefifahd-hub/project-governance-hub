{
  "name": "WBSMapping",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "externalWbsCode": {
      "type": "string"
    },
    "externalWbsName": {
      "type": "string"
    },
    "unifiedWbsCode": {
      "type": "string"
    },
    "unifiedWbsName": {
      "type": "string"
    },
    "workstream": {
      "type": "string",
      "enum": [
        "NMC Cylindrical",
        "Na Electrode",
        "NMC Flexible",
        "Common/Shared",
        "Building/LDC",
        "PMO"
      ]
    },
    "qualityGate": {
      "type": "string",
      "enum": [
        "QG0",
        "QG1",
        "QG2",
        "QG3",
        "QG4",
        "QG5",
        "QG6"
      ]
    },
    "isMapped": {
      "type": "boolean",
      "default": false
    },
    "autoMapped": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "projectId",
    "sourceId",
    "externalWbsCode",
    "unifiedWbsCode"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}