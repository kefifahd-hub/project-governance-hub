{
  "name": "DailySiteReport",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string"
    },
    "reportRef": {
      "type": "string",
      "description": "e.g. DSR-20260219"
    },
    "reportDate": {
      "type": "string",
      "format": "date"
    },
    "preparedBy": {
      "type": "string"
    },
    "contractorName": {
      "type": "string"
    },
    "contractorRepresentative": {
      "type": "string"
    },
    "contractReference": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted",
        "Reviewed",
        "Approved"
      ],
      "default": "Draft"
    },
    "approvedBy": {
      "type": "string"
    },
    "approvedDate": {
      "type": "string",
      "format": "date"
    },
    "enabledSections": {
      "type": "string",
      "description": "JSON section config"
    },
    "weatherSunny": {
      "type": "boolean"
    },
    "weatherCloudy": {
      "type": "boolean"
    },
    "weatherRainy": {
      "type": "boolean"
    },
    "weatherSnow": {
      "type": "boolean"
    },
    "weatherFrost": {
      "type": "boolean"
    },
    "weatherLightning": {
      "type": "boolean"
    },
    "tempMinC": {
      "type": "number"
    },
    "tempMaxC": {
      "type": "number"
    },
    "windSpeedMaxMs": {
      "type": "number"
    },
    "weatherImpactOnWork": {
      "type": "boolean"
    },
    "weatherImpactDescription": {
      "type": "string"
    },
    "manpowerEntries": {
      "type": "string",
      "description": "JSON array of manpower rows"
    },
    "equipmentEntries": {
      "type": "string",
      "description": "JSON array of equipment rows"
    },
    "materialDeliveries": {
      "type": "string",
      "description": "JSON array of deliveries"
    },
    "remarkableEvents": {
      "type": "string",
      "description": "JSON array of events"
    },
    "additionalNotes": {
      "type": "string"
    },
    "totalWorkers": {
      "type": "number"
    },
    "totalHours": {
      "type": "number"
    }
  },
  "required": [
    "projectId",
    "reportDate",
    "preparedBy"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}