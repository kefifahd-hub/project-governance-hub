{
  "name": "DCFAssumptions",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent FinanceModel/Project (denormalized for RLS)"
    },
    "financeModelId": {
      "type": "string"
    },
    "valuationYear": {
      "type": "number",
      "default": 2026
    },
    "discountRatePct": {
      "type": "number",
      "default": 18,
      "description": "WACC / discount rate %"
    },
    "terminalGrowthRatePct": {
      "type": "number",
      "default": 1.5
    }
  },
  "required": [
    "financeModelId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}