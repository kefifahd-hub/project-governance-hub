{
  "name": "Requirement",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID inherited from parent Project (denormalized for RLS)"
    },
    "projectId": {
      "type": "string",
      "description": "Project ID"
    },
    "reqCode": {
      "type": "string",
      "description": "Requirement code e.g. REQ-001"
    },
    "description": {
      "type": "string",
      "description": "Requirement description"
    },
    "reqType": {
      "type": "string",
      "enum": [
        "Functional",
        "Non-functional",
        "Business",
        "Technical",
        "Regulatory"
      ],
      "default": "Functional"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Must",
        "Should",
        "Could",
        "Won't"
      ],
      "default": "Should"
    },
    "source": {
      "type": "string",
      "description": "Source of requirement"
    },
    "status": {
      "type": "string",
      "enum": [
        "Proposed",
        "Approved",
        "Implemented",
        "Verified",
        "Deferred"
      ],
      "default": "Proposed"
    },
    "acceptanceCriteria": {
      "type": "string",
      "description": "Acceptance criteria"
    },
    "wbsCode": {
      "type": "string",
      "description": "WBS code traceability"
    }
  },
  "required": [
    "projectId",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.org_id": "{{user.data.org_id}}"
        }
      ]
    }
  }
}