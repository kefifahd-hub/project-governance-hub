{
  "name": "Stamp org_id on ScheduleDelta create",
  "description": "Stamps org_id on new ScheduleDelta records from parent Project.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ScheduleDelta"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "stamp_org_id_on_scheduledelta_create",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "stamp_org_id": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "stampOrgId",
            "args": {
              "entity_name": "ScheduleDelta",
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Stamp org_id",
            "description": "From parent Project"
          }
        }
      }
    ]
  }
}