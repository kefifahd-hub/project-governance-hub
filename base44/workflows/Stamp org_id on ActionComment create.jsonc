{
  "description": "Stamps org_id on new ActionComment records from parent ActionItem.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "stamp_org_id_on_actioncomment_create",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "stamp_org_id": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "stampOrgId",
            "args": {
              "entity_name": "ActionComment",
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Stamp org_id",
            "description": "From parent ActionItem"
          }
        }
      }
    ]
  },
  "name": "Stamp org_id on ActionComment create",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ActionComment"
    }
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "stampOrgIdOnCreate"
  }
}